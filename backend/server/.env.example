# Copy to backend/server/.env and fill in. Never commit .env (it is in .gitignore).

PORT=3000

PGHOST=localhost
PGPORT=5432
# exactly as the database is named, capitals included (e.g. Domboshava)
PGDATABASE=domboshava_lis
# PGSSL=true            # when the database is on another machine

# Two database roles (db/02_audit_and_security.sql). Set their passwords with
#   ALTER ROLE lis_api PASSWORD '...';  ALTER ROLE lis_public PASSWORD '...';
API_DB_USER=lis_api
API_DB_PASSWORD=
PUBLIC_DB_USER=lis_public
PUBLIC_DB_PASSWORD=

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_SECRET=
TOKEN_TTL_HOURS=8

# Frontend addresses allowed to call this API from another origin.
# Needed when the client runs separately, e.g. VS Code Live Server on 5500.
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

METADATA_CONTACT=Group 01, HSVG437 Cadastres and LIS, Midlands State University
